# Copia in .env e compila. MAI committare .env
APP_MODE=demo                 # demo = dati finti | production = dati reali
SECRET_KEY=cambia-questa-chiave-lunga-e-casuale
ADMIN_USER=admin
ADMIN_PASSWORD=               # usata SOLO al primo avvio per creare l'hash; poi cancellala
PORT=5000

# Email (SMTP). Se vuoto, le email finiscono in data/outbox.log
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
OWNER_EMAIL=

# Assistente AI (provider compatibile OpenAI; es. proxy su VPS). Se vuoto: risposte base senza AI
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# Assistente telefonico (predisposto, NON attivo)
PHONE_AI_ENABLED=0
PHONE_WEBHOOK_TOKEN=
