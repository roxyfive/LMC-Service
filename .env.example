# Copia in .env e compila. MAI committare .env.
# Attenzione: nessun commento sulla stessa riga del valore (systemd EnvironmentFile non li toglie): i commenti vanno su righe proprie.

# demo = dati finti e bollini DEMO | production = dati reali
APP_MODE=demo
# Chiave di sessione. Se vuota se ne genera una e si salva in data/secret.key (vale per tutti i worker).
SECRET_KEY=
ADMIN_USER=admin
# Usata SOLO al primo avvio per creare l'hash; poi cancellala.
ADMIN_PASSWORD=
PORT=5000

# Dietro nginx/HTTPS metti 1 (IP e https reali, rate limit corretto). COOKIE_SECURE=1 solo con HTTPS.
TRUST_PROXY=0
COOKIE_SECURE=0
# 1 = niente thread di sfondo (usa cron: python run.py --report e --promemoria)
LMC_NO_BG=0

# Email (SMTP). Se vuoto, le email finiscono in data/outbox.log
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
OWNER_EMAIL=

# Assistente AI (provider compatibile OpenAI). Se vuoto: risposte base dal database, senza AI esterna
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# --- WhatsApp via Twilio (in alternativa a Admin > Impostazioni; ciò che è salvato in admin ha la precedenza) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Numero mittente WhatsApp, es. +14155238886 (sandbox) o il tuo numero WhatsApp Business
TWILIO_WHATSAPP_FROM=
# Facoltativo: Content SID del template approvato (HX...), necessario per scrivere oltre le 24 ore
TWILIO_CONTENT_SID=
# Numeri extra destinatari, separati da virgola
WHATSAPP_DESTINATIONS=

# --- Vapi (assistente vocale) ---
VAPI_PUBLIC_KEY=
VAPI_ASSISTANT_ID=
VAPI_EMERGENCY_ASSISTANT_ID=
VAPI_API_KEY=
VAPI_WEBHOOK_SECRET=

# Assistente telefonico (vecchio webhook, NON attivo)
PHONE_AI_ENABLED=0
PHONE_WEBHOOK_TOKEN=
