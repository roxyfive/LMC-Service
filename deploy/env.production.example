# /srv/lmc/.env  — configurazione di PRODUZIONE. Permessi: chmod 600 /srv/lmc/.env
# MAI su git. Nessun commento sulla stessa riga del valore (systemd non li toglie).
APP_MODE=production
# Se vuota se ne genera una e si salva in data/secret.key (inclusa nel backup cifrato). Meglio una fissa:
# python3 -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=
ADMIN_USER=admin
# SOLO per il primo avvio (crea l'utente). Poi CANCELLA questa riga e cambia password da Admin > Cambia password.
ADMIN_PASSWORD=
PORT=8010
# Dietro nginx con HTTPS: entrambi a 1
TRUST_PROXY=1
COOKIE_SECURE=1
# 1 = niente thread di sfondo (usa cron per report e promemoria, vedi DEPLOY.md)
LMC_NO_BG=0

# Email (promemoria appuntamenti, conferme). Se vuoto finiscono in data/outbox.log
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
OWNER_EMAIL=lamusiccompany.24@gmail.com

# Assistente AI esterno (facoltativo; senza, l'assistente risponde dai dati del sito)
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# WhatsApp (Twilio) e Vapi: si inseriscono da Admin > Impostazioni (consigliato). Qui solo in alternativa.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_CONTENT_SID=
WHATSAPP_DESTINATIONS=
VAPI_PUBLIC_KEY=
VAPI_ASSISTANT_ID=
VAPI_EMERGENCY_ASSISTANT_ID=
VAPI_API_KEY=
VAPI_WEBHOOK_SECRET=
